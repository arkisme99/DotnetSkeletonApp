@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    // Menghubungkan ke Master Layout
    Layout = "Crud/_CardLayout";
}

<form asp-controller="@ViewData["currentController"]" asp-action="@(ViewData["actionForm"] ?? "Create")" method="post"
    id="formProccess" enctype="@ViewData["attributeForm"]">
    @RenderBody()

    @await Html.PartialAsync("Components/_SubmitSave")
</form>

@section TitleInfo {
    <i class="fal fa-plus"></i>&nbsp;@Localizer["CreateNew"] @ViewData["Title"]
}

@section PanelToolbar {
    @await Html.PartialAsync("Components/_ButtonBack")
}

@section Styles {
    @* Salurkan section Styles dari Index ke _Layout *@
    @RenderSection("Styles", required: false)
}

@section Scripts {
    <script src="~/helpers/js/form-handler.js"></script>

    @* Salurkan section Scripts dari Index ke _Layout *@
    @RenderSection("Scripts", required: false)

    <script>
        $(function () {
            handleFormSubmission({
                formSelector: '#formProccess',
                buttonSelector: '#btnSave'
            });
        });
    </script>
}

@section HeaderInfo {
    @* Salurkan section HeaderInfo dari Index ke _Layout *@
    @RenderSection("HeaderInfo", required: false)
}