@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    // Menghubungkan ke Master Layout
    Layout = "Crud/_CardLayout";
}

<form asp-controller="@ViewData["currentController"]" asp-action="Edit" method="post" id="formProccess">
    @RenderBody()

    @await Html.PartialAsync("Components/_SubmitSave")
</form>

@section TitleInfo {
    <i class="fal fa-pencil"></i>&nbsp;@Localizer["EditData"] @ViewData["Title"]
}

@section PanelToolbar {
    @await Html.PartialAsync("Components/_ButtonBack")
}

@section Styles {

}

@section Scripts {
    <script src="~/helpers/js/form-handler.js"></script>

    <script>
        $(function () {
            handleFormSubmission({
                formSelector: '#formProccess',
                buttonSelector: '#btnSave'
            });
        });
    </script>
}

@section HeaderInfo {
    @* Salurkan section HeaderInfo dari Index ke _Layout *@
    @RenderSection("HeaderInfo", required: false)
}