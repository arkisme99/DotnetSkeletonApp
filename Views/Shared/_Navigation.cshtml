@using System.Security.Claims
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var roles = User.Claims
    .Where(c => c.Type == ClaimTypes.Role)
    .Select(c => c.Value)
    .ToList();
}
<aside class="page-sidebar">
    <div class="page-logo">
        <a href="" class="page-logo-link press-scale-down d-flex align-items-center position-relative"
            data-toggle="modal" data-target="#modal-shortcut">
            <img src="@ViewData["logoPath"]" alt="@ViewData["Title"] - @ViewData["nameApp"]"
                aria-roledescription="logo">
            <span class="page-logo-text mr-1">@ViewData["Title"] - @ViewData["nameApp"]</span>
            <span class="position-absolute text-white opacity-50 small pos-top pos-right mr-2 mt-n2"></span>
        </a>
    </div>

    <nav id="js-primary-nav" class="primary-nav" role="navigation">
        <div class="nav-filter">
            <div class="position-relative">
                <input type="text" id="nav_filter_input" placeholder="Filter menu" class="form-control" tabindex="0">
                <a href="#" onclick="return false;" class="btn-primary btn-search-close js-waves-off"
                    data-action="toggle" data-class="list-filter-active" data-target=".page-sidebar">
                    <i class="fal fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="info-card pt-3" style="flex-direction: column !important">
            <div class="">
                <img src="@ViewData["profileImage"]" class="profile-image rounded-circle " alt="@User.Identity?.Name"
                    style="margin-top: 10px;">
            </div>
            <div class="info-card-text " style="margin-top: 10px; align-items: center">
                <a href="" class="text-white">
                    <span class="text-truncate text-truncate-sm d-inline-block">@User.Identity?.Name <i
                            class="fal fa-edit"></i></span>
                </a>
                <span class="text-truncate text-truncate-sm text-center">@string.Join(", ", roles)</span>
            </div>
            <img src="~/sources/img/card-backgrounds/cover-2-lg.png" class="cover" alt="cover">
            <a href="#" onclick="return false;" class="pull-trigger-btn" data-action="toggle"
                data-class="list-filter-active" data-target=".page-sidebar" data-focus="nav_filter_input">
                <i class="fal fa-angle-down"></i>
            </a>
        </div>
        <ul id="js-nav-menu" class="nav-menu">
            <li class="@(Context.Request.Path.StartsWithSegments("/home") ? "active" : "")">
                <a asp-controller="Home" asp-action="Index" title="@Localizer["Home"]" data-filter-tags="home">
                    <i class="fal fa-globe"></i>
                    <span class="nav-link-text" data-i18n="nav.home">@Localizer["Home"]</span>
                </a>
            </li>
            @if (User.HasClaim("Permission", "View_User"))
            {
                <li class="@(Context.Request.Path.StartsWithSegments("/user") ? "active" : "")">
                    <a asp-controller="User" asp-action="Index" title="@Localizer["User"]" data-filter-tags="user">
                        <i class="fal fa-users"></i>
                        <span class="nav-link-text" data-i18n="nav.user">@Localizer["User"]</span>
                    </a>
                </li>
            }
        </ul>
        <div class="filter-message js-filter-message bg-success-600"></div>
    </nav>
    <div class="nav-footer shadow-top">
        <a href="#" onclick="return false;" data-action="toggle" data-class="nav-function-minify"
            class="hidden-md-down">
            <i class="ni ni-chevron-right"></i>
            <i class="ni ni-chevron-right"></i>
        </a>
        <ul class="list-table m-auto nav-footer-buttons">
            <li>
                <a href="" data-toggle="tooltip" data-placement="top" title="Setup App">
                    <i class="fal fa-cogs"></i>
                </a>
            </li>
        </ul>
    </div>

</aside>