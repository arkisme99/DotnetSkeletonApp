@if (User.HasClaim("Permission", $"Create_{ViewData["currentController"]}"))
{
    <a asp-controller="@ViewData["currentController"]" asp-action="Create"
        class="btn btn-sm btn-success btn-icon waves-effect waves-themed" data-toggle="tooltip" data-placement="bottom"
        data-original-title="Create New" data-trigger="hover"><i class="fal fa-plus"></i> </a>
}