@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="modal fade example-modal-centered-transparent" id="modal-logout" tabindex="-1" role="dialog"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-transparent" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-white">
                    @Localizer["Informasi"] !
                </h4>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fal fa-times"></i></span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-white">@Localizer["InfoKeluarApp"] ?</p>
            </div>
            <div class="modal-footer">
                <form asp-controller="Auth" asp-action="Logout" method="POST">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Batal"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["YaKeluar"]</button>
                </form>
            </div>
        </div>
    </div>
</div>