<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    let countGlobal = 0;

    $(function () {
        // Semua kode jQuery Anda diletakkan di sini
        console.log("DOM sudah siap!");

        // Panggil fungsi AJAX Anda di sini agar jalan saat page load
        loadNotifications();
    });

    let connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/notification")
        .build();

    //ini kalau websocket error
    Object.defineProperty(WebSocket, 'OPEN', { value: 1, });

    connection.start()
        .then(function () {
            console.log("Connected to SignalR");
        })
        .catch(function (err) {
            console.error(err.toString())
        });

    connection.on("ReceiveNotification", function (data) {
        countGlobal++
        const msg = `${data.message}`;
        toastr.success(msg);
        addNotificationToList(data);
        @* console.log(`Data Notif ${JSON.stringify(data)}`); *@
    });

    connection.on("JobSuccess", data => {
        countGlobal++
        const msg = `${data.message}`;
        toastr.success(msg);
        addNotificationToList(data);
    });

    connection.on("JobFailed", data => {
        countGlobal++
        const msg = `${data.message}`;
        toastr.error(msg);
        addNotificationToList(data);
    });

    connection.on("JobRetry", data => {
        countGlobal++
        const msg = `${data.message}`;
        toastr.warning(msg);
        addNotificationToList(data);
    });

    function readAllNotifications() {
        $.ajax({
            url: `/read-all-notifications`,
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    loadNotifications()
                }

            },
            error: function (xhr, status, error) {
                console.error("Terjadi kesalahan: " + error);
            }
        });
    }

    function readNotifications(idNotif) {
        $.ajax({
            url: `/read-notification/${idNotif}`,
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    loadNotifications()
                }

            },
            error: function (xhr, status, error) {
                console.error("Terjadi kesalahan: " + error);
            }
        });
    }

    function loadNotifications() {
        $.ajax({
            url: '/get-all-notifications',
            type: 'GET',
            success: function (data) {
                countGlobal = data.count

                // clear items dulu
                $("#listNotification").html('');
                $(".countNotification").html(countGlobal)

                $.each(data.items, function (index, item) {
                    addNotificationToList(item)
                });

            },
            error: function (xhr, status, error) {
                console.error("Terjadi kesalahan: " + error);
            }
        });
    }

    function addNotificationToList(data) {
        let linkFile = '';

        if (data.fileUrl === null) {
            linkFile = '';
        } else {
            linkFile = `<a href="${data.fileUrl}">download</a>`;
        }

        const dateObj = new Date(data.createdAt);

        const localDateTime = dateObj.toLocaleString('id-ID', {
            dateStyle: 'medium',
            timeStyle: 'short'
        });

        @* console.log(`localDateTime: ${localDateTime}`); *@

        // Template li (tambahkan styling CSS sesuai selera)
        const listItem = `
            <li class="unread">
                <div class="d-flex align-items-center show-child-on-hover">
                    <span class="d-flex flex-column flex-1">
                        <span class="msg-a fs-sm">
                            ${data.message}
                            ${linkFile}
                        </span>
                        <span class="fs-nano text-muted mt-1">${localDateTime}</span>
                    </span>
                    <div
                    class="show-on-hover-parent position-absolute pos-right pos-bottom p-3"
                    >
                    <a href="javascript:void(0)" class="text-muted" title="read" onclick="readNotifications('${data.id}')"
                        ><i class="fal fa-eye"></i
                    ></a>
                    </div>
                </div>
            </li>`;

        // .prepend() membuat item baru muncul di paling atas
        $("#listNotification").prepend(listItem);

        $(".countNotification").html(countGlobal)
    }
</script>