@using DotnetSkeletonApp.Models.ViewModels
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    Layout = "_LayoutGuest";
    ViewData["Title"] = "Login Page";

    var inputGroupEmail = new InputGroupViewModel
    {
        Label = @Localizer["Youre Email"],
        Type = "email",
        Name = "email",
        Id = "email",
        PlaceHolder = @Localizer["Enter your Email"],
        Attributes = "autofocus required",
        Icon = "fal fa-envelope"
    };

    var inputGroupPassword = new InputGroupViewModel
    {
        Label = @Localizer["Youre Password"],
        Type = "password",
        Name = "password",
        Id = "password",
        PlaceHolder = @Localizer["Enter your Password"],
        Attributes = "required",
        Icon = "show-password-toggle fal fa-eye",
        DataTargetIcon = "#password"
    };

    var submitForm = new SubmitCustomViewModel
    {
        Label = @Localizer["Login"],
        Id = "btnSubmit",
        AddNewClass = "btn-block"
    };

    var checkBoxRememberMe = new InputCheckboxViewModel
    {
        Label = @Localizer["Remember me"],
        Id = "remember_me",
        Name = "remember"
    };

}

<form asp-action="Login" method="post" id="formProccess">

    @await Html.PartialAsync("Components/_InputGroup", inputGroupEmail)
    @await Html.PartialAsync("Components/_InputGroup", inputGroupPassword)

    <div class="row">
        <div class="col-6">
            @await Html.PartialAsync("Components/_InputCheckbox", checkBoxRememberMe)
        </div>
        <!-- /.col -->
        <div class="col-6">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">
            @await Html.PartialAsync("Components/_SubmitCustom", submitForm)
        </div>
        <!-- /.col -->
    </div>
</form>

<p class="text-center text-muted small mt-1 mb-1">
    <strong>@ViewData["planApp"] | <em>Version: @ViewData["versiApp"]</em></strong>
</p>

@section Scripts {
    <script src="~/helpers/js/form-handler.js"></script>
    <script src="~/helpers/js/showpassword.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="https://www.google.com/recaptcha/api.js?render=@ViewBag.SiteKey"></script>
    <script>
        handleFormSubmission({
            formSelector: '#formProccess',
            buttonSelector: '#btnSubmit',
            captchaSiteKey: "@ViewBag.SiteKey"
        });
    </script>
}